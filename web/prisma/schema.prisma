// RankPath — SQLite-ported schema (original Postgres version: schema.postgres.prisma.bak).
// SQLite doesn't support Prisma enums or scalar lists, so enum fields became String
// (same literal values) and CutoffSummary.sourceFiles String[] became a String.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  // Student profile (captured at registration; used to pre-fill predictions)
  phone         String?
  gender        String?   // Male | Female | Other
  category      String?   // OPEN | EWS | OBC | SC | ST
  domicileState String?   // state code, e.g. AP
  neetRank      Int?      // All India Rank
  neetScore     Int?      // NEET marks
  neetYear      Int?      // attempt year
  hasPaid       Boolean   @default(false)
  paidAt        DateTime?
  role          String    @default("STUDENT")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]

  @@index([email])
}

model Payment {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  provider   String   @default("DEMO") // DEMO | RAZORPAY
  amount     Int                       // in paise (₹99 = 9900)
  currency   String   @default("INR")
  status     String   @default("CREATED") // CREATED | PAID | FAILED
  orderId    String?
  paymentRef String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model CounsellingAuthority {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  scope        String?
  urlCurrent   String?
  urlArchive   String?
  state        State?   @relation(fields: [stateId], references: [id])
  stateId      String?
  allotments   Allotment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model State {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  colleges     College[]
  authorities  CounsellingAuthority[]
}

model College {
  id             String   @id @default(cuid())
  name           String
  code           String?
  type           String   @default("UNKNOWN")
  city           String?
  state          State?   @relation(fields: [stateId], references: [id])
  stateId        String?
  feeBandDefault String   @default("UNKNOWN")
  isMinority     Boolean  @default(false)
  isDeemed       Boolean  @default(false)
  isCentral      Boolean  @default(false)
  allotments     Allotment[]
  seatMatrix     SeatMatrix[]
  cutoffs        CutoffSummary[]
  fees           FeeStructure[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name, stateId])
  @@index([type])
  @@index([stateId])
}

model Course {
  id          String   @id @default(cuid())
  name        String   @unique
  durationYrs Int      @default(5)
  allotments  Allotment[]
  seatMatrix  SeatMatrix[]
  cutoffs     CutoffSummary[]
}

model CategoryMap {
  id         String   @id @default(cuid())
  rawCode    String   @unique
  normalized String
  state      String?
  note       String?
  createdAt  DateTime @default(now())
}

model QuotaMap {
  id         String   @id @default(cuid())
  rawCode    String   @unique
  normalized String
  note       String?
  createdAt  DateTime @default(now())
}

model Allotment {
  id                   String   @id @default(cuid())
  year                 Int
  round                String
  authority            CounsellingAuthority? @relation(fields: [authorityId], references: [id])
  authorityId          String?
  authorityCode        String
  state                String?
  college              College? @relation(fields: [collegeId], references: [id])
  collegeId            String?
  course               Course?  @relation(fields: [courseId], references: [id])
  courseId             String?
  rawInstituteName     String?
  rawCourse            String?
  rawSeatCategory      String?
  rawCandidateCategory String?
  rawQuota             String?
  normalizedCategory   String?
  normalizedQuota      String?
  candidateRank        Int?
  neetMarks            Int?
  gender               String?
  pwd                  Boolean?
  collegeType          String   @default("UNKNOWN")
  feeBand              String   @default("UNKNOWN")
  sourceUrl            String?
  sourceFile           String?
  lastUpdated          DateTime @default(now())
  rawRowHash           String   @unique
  status               String   @default("PUBLISHED")
  createdAt            DateTime @default(now())

  @@index([year, round])
  @@index([normalizedCategory])
  @@index([normalizedQuota])
  @@index([state])
  @@index([collegeId, courseId, year, round])
}

model FeeStructure {
  id            String   @id @default(cuid())
  college       College  @relation(fields: [collegeId], references: [id])
  collegeId     String
  course        String   @default("MBBS")
  year          Int?
  tuitionAnnual Int?     // INR per year
  hostelAnnual  Int?
  otherAnnual   Int?     // misc/university/exam charges per year
  nriTuition    Int?     // INR per year for NRI seats
  currency      String   @default("INR")
  isIndicative  Boolean  @default(true) // true = type-based estimate, false = official figure
  sourceUrl     String?
  note          String?
  updatedAt     DateTime @updatedAt

  @@unique([collegeId, course, year])
  @@index([collegeId])
}

model SeatMatrix {
  id         String   @id @default(cuid())
  year       Int
  round      String
  college    College  @relation(fields: [collegeId], references: [id])
  collegeId  String
  course     Course   @relation(fields: [courseId], references: [id])
  courseId   String
  quota      String
  category   String
  seats      Int
  sourceFile String?

  @@unique([year, round, collegeId, courseId, quota, category])
  @@index([year, round])
}

model CutoffSummary {
  id             String   @id @default(cuid())
  year           Int
  round          String
  college        College  @relation(fields: [collegeId], references: [id])
  collegeId      String
  course         Course   @relation(fields: [courseId], references: [id])
  courseId       String
  category       String
  quota          String
  openingRank    Int?
  closingRank    Int
  allotmentCount Int
  sourceFiles    String?

  @@unique([year, round, collegeId, courseId, category, quota])
  @@index([category, quota, year])
  @@index([collegeId, courseId])
}

model PredictionLog {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  inputRank        Int
  inputCategory    String
  inputQuota       String
  inputState       String?
  inputGender      String?
  inputPwd         Boolean?
  inputCollegeType String?
  inputBudget      String?
  resultCount      Int
  topResults       String
  appVersion       String?

  @@index([createdAt])
}

model AdminUpload {
  id         String   @id @default(cuid())
  filename   String
  authority  String?
  year       Int?
  round      String?
  rowsParsed Int      @default(0)
  rowsLoaded Int      @default(0)
  errors     String?
  status     String   @default("PENDING_REVIEW")
  uploadedBy String?
  createdAt  DateTime @default(now())
}
